# ตัวอย่าง Environment Variables (ไม่มีค่าจริง)
# คัดลอกเป็น .env.local แล้วใส่ค่าของโปรเจกต์ Supabase ใหม่ — ห้ามนำ .env.local ขึ้น git
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# ใช้ฝั่ง server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ (คีย์ที่ขึ้นต้น sb_secret_ หรือ service_role)
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# รหัสกลางเข้าหลังบ้าน (/admin) — ตั้งเองได้
ADMIN_ACCESS_PASSWORD=<รหัสผู้ดูแล>
# ข้อความสุ่มยาวอย่างน้อย 32 ตัวอักษร ใช้เซ็น cookie ผู้ดูแล (เปลี่ยนค่า = ออกจากระบบทุกเครื่อง)
ADMIN_SESSION_SECRET=<ข้อความสุ่มยาว>

# (ไม่บังคับ) true = ช่วงทดสอบ: ฝั่งสาขาต้องใส่รหัสผู้ดูแลก่อนเข้า · ไม่ตั้ง = เปิดให้พนักงานใช้
# STOCK_REQUEST_TESTING=true
